{
  "name": "mixdive-js",
  "private": true,
  "version": "0.0.0",
  "description": "Mixdive JavaScript SDKs — the browser SDK (web tag + npm) and the React bindings.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/browser",
    "packages/react"
  ],
  "scripts": {
    "build": "npm run build -w @mixdive/browser && npm run build -w @mixdive/react",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
