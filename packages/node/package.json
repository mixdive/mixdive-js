{
  "name": "@mixdive/node",
  "version": "0.1.0",
  "description": "Self-hosted product analytics from your servers. Events, user profiles and records sent to the Mixdive server you run, from Node.js or the edge.",
  "license": "Apache-2.0",
  "homepage": "https://mixdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixdive/mixdive-js.git",
    "directory": "packages/node"
  },
  "bugs": "https://github.com/mixdive/mixdive-js/issues",
  "keywords": [
    "mixdive",
    "analytics",
    "product-analytics",
    "server-side",
    "self-hosted",
    "privacy",
    "event-tracking",
    "node",
    "edge"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
