{
  "name": "@mixdive/next",
  "version": "0.1.0",
  "description": "Self-hosted product analytics for Next.js. Page views that follow the App Router, a provider for the root layout, and events from Server Actions and Route Handlers sent after the response.",
  "license": "Apache-2.0",
  "homepage": "https://mixdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixdive/mixdive-js.git",
    "directory": "packages/next"
  },
  "bugs": "https://github.com/mixdive/mixdive-js/issues",
  "keywords": [
    "mixdive",
    "analytics",
    "product-analytics",
    "nextjs",
    "next",
    "app-router",
    "server-actions",
    "self-hosted",
    "privacy",
    "page-views",
    "event-tracking"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mixdive/node": "^0.1.0",
    "@mixdive/react": "^0.1.3"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
