{
  "name": "@mixdive/react",
  "version": "0.1.1",
  "description": "Self-hosted product analytics for React. The Mixdive provider, the useMixdive hook, and page views that follow your router.",
  "license": "Apache-2.0",
  "homepage": "https://mixdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixdive/mixdive-js.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/mixdive/mixdive-js/issues",
  "keywords": [
    "mixdive",
    "analytics",
    "product-analytics",
    "react",
    "self-hosted",
    "privacy",
    "page-views",
    "event-tracking"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mixdive/browser": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
