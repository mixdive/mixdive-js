{
  "name": "@mixdive/browser",
  "version": "0.1.1",
  "description": "Self-hosted product analytics for the web. The Mixdive script tag and npm client: page views, visitors, sessions and your own events.",
  "license": "Apache-2.0",
  "homepage": "https://mixdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixdive/mixdive-js.git",
    "directory": "packages/browser"
  },
  "bugs": "https://github.com/mixdive/mixdive-js/issues",
  "keywords": [
    "mixdive",
    "analytics",
    "product-analytics",
    "web-analytics",
    "self-hosted",
    "privacy",
    "gdpr",
    "cookieless",
    "page-views",
    "event-tracking"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/mixdive.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tag": "./dist/mixdive.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
